<Project Sdk="Microsoft.NET.Sdk">

    <!-- cuo-mod-sdk-dotnet — guest-side SDK for C# ClassicUO mods (wasm32-wasip2
         components, world cuo:modding/mod); the .NET twin of ../rust. Plain net10.0
         classlib: a mod references it through ModSdk.props / ModSdk.targets and publishes
         wasi-wasm — ILC compiles the SDK IL into the mod's component. The exports (setup +
         one per system) are generated into the mod by ModSdk.targets (ModDescribe.cs).
         Wit/ is the wit-bindgen canonical-ABI import glue (regen-wit.sh). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <AssemblyName>CuoModSdk</AssemblyName>
        <RootNamespace>CuoModSdk</RootNamespace>
    </PropertyGroup>

</Project>
