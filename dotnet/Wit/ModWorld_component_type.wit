    scroll: func(v: scroll-position) -> entity-builder;
    scrollbar: func(v: ui-scrollbar) -> entity-builder;
    stat-lock-button: func(v: stat-lock-button) -> entity-builder;
    statusbar-window: func(v: status-bar-window) -> entity-builder;
    supersedes: func(v: mod-supersedes) -> entity-builder;
    text-hue: func(v: text-hue) -> entity-builder;
    text-input: func() -> entity-builder;
    text-spans: func(v: text-spans) -> entity-builder;
    text-wrap: func(v: text-wrap) -> entity-builder;
    tooltip: func(v: ui-tooltip) -> entity-builder;
    topbar-bg: func() -> entity-builder;
    topbar-button: func() -> entity-builder;
    topbar-full: func() -> entity-builder;
    topbar-root: func() -> entity-builder;
  }

  entity-of: func(c: borrow<commands>, e: entity) -> entity-builder;

