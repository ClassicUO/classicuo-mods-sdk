<Project>
  <!-- Import at the TOP of a mod csproj (pair with ModSdk.targets at the bottom).
       The standard property block for a core-wasm C# mod; everything a mod may want
       to override is Condition-guarded. See ecs-csharp for the canonical consumer. -->
  <PropertyGroup>
    <OutputType Condition="'$(OutputType)' == ''">Library</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">wasi-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>

    <!-- ILC.LLVM 10.0.0-rc NREs under OptimizationPreference=Speed (PGO on);
         Size leaves PGO off — required (see tools/spikes/ilc-core). -->
    <OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Size</OptimizationPreference>
    <WasmEnableSIMD>true</WasmEnableSIMD>

    <!-- cdylib-style output name: ecs-foo -> ecs_foo (the Makefile copies $(TargetName).wasm). -->
    <TargetName Condition="'$(TargetName)' == ''">$(MSBuildProjectName.Replace('-','_'))</TargetName>

    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Do NOT set <PublishAot>: the experimental ILC engages AOT itself on -r wasi-wasm. -->
  </PropertyGroup>

  <!-- A mod writes `class MyMod : Mod` and names host types (Node, Hits, Color…)
       unqualified; these are the only namespaces it needs and they are never ambiguous
       with the implicit System.* set. ModAbi (the raw wire tables) is deliberately NOT
       here — nothing in the mod-facing API exposes it. -->
  <ItemGroup>
    <Using Include="CuoModSdk" />
    <Using Include="CuoModSdk.Types" />
  </ItemGroup>
</Project>
