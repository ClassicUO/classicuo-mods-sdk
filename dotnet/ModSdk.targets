<Project>
  <!-- Import at the BOTTOM of a mod csproj (pair with ModSdk.props at the top). -->

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-*" />
    <PackageReference Include="runtime.$(NETCoreSdkRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-*" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)CuoModSdk.csproj" />

    <!-- Export the SDK's UnmanagedCallersOnly entrypoints (run / observe /
         observe-packet / cabi_post_observe-packet) from the mod's component. `setup` is
         the one export that must construct the mod's own type, so it is generated below
         instead. -->
    <UnmanagedEntryPointsAssembly Include="CuoModSdk" />

    <!-- World cuo:modding/mod: wasm-component-ld encodes the module as a wasip2
         COMPONENT of this world (NativeAOT-LLVM's default wasi target is wasip2; the
         runtime's own wasi wit is globbed in beside it by Microsoft.NETCore.Native.Wasm.targets). -->
    <WasmComponentTypeWit Include="$(MSBuildThisFileDirectory)Wit\ModWorld_component_type.wit" />
  </ItemGroup>

  <!-- The `setup` export, generated from <CuoModType>. It is also ILC's only root for
       the mod's own code (nothing in the SDK references the mod assembly), so it cannot
       live in the SDK. No Inputs/Outputs: the Compile item must be added on every build,
       and WriteOnlyWhenDifferent keeps the file's timestamp stable for incremental. -->
  <Target Name="GenerateModEntry" BeforeTargets="BeforeCompile;CoreCompile">
    <Error Condition="'$(CuoModType)' == ''"
           Text="Set &lt;CuoModType&gt; to the mod's CuoModSdk.Mod subclass (e.g. &lt;CuoModType&gt;MyMod.Entry&lt;/CuoModType&gt;) — the SDK generates the setup export from it." />
    <PropertyGroup>
      <_CuoModEntry>$(IntermediateOutputPath)ModEntry.g.cs</_CuoModEntry>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CuoModEntry)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated&gt; by ModSdk.targets — the component's setup export for $(CuoModType).;internal static class CuoModEntry;{;    // setup: func(app: own&lt;app&gt;);    [System.Runtime.InteropServices.UnmanagedCallersOnly(EntryPoint = &quot;setup&quot;)];    static void Setup(int app) =&gt; CuoModSdk.ModRuntime.Setup(app, new global::$(CuoModType)())%3B;}" />
    <ItemGroup>
      <Compile Include="$(_CuoModEntry)" />
      <FileWrites Include="$(_CuoModEntry)" />
    </ItemGroup>
  </Target>
</Project>
