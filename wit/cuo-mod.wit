    record racial-book-window {
        page: s32,
        sounded-page: s32,
        page-count: s32,
        dict-pages: s32,
        ability-count: s32,
        /// enum RaceType (1=HUMAN, 2=ELF, 3=GARGOYLE)
        race: u8,
        dirty: bool,
        content: u64,
        left: u64,
        right: u64,
    }

    /// `cuo:gump/server-closed`
    record server-gump-closed-event {
        serial: u32,
        gump-id: u32,
    }

    /// `cuo:gump/server-opened`
    record server-gump-opened-event {
        serial: u32,
        gump-id: u32,
    }

    /// `cuo:gump/skills`
    record skills-window {
        special-height: s32,
        minimized: bool,
        show-real: bool,
        show-caps: bool,
        dirty: bool,
        width: s32,
        list-width: f32,
        content-height: f32,
        list-entity: u64,
        top-entity: u64,
        mid-entity: u64,
        bottom-entity: u64,
        title-entity: u64,
        minimize-entity: u64,
        expander-entity: u64,
        sum-label-entity: u64,
        flag-entity: u64,
        last-sum: f32,
    }

    /// `cuo:gump/spellbook`
    record spellbook-window {
        serial: u32,
        /// enum SpellBookType (0=Magery, 1=Necromancy, 2=Chivalry, 4=Bushido, 5=Ninjitsu, 6=Spellweaving, 7=Mysticism, 8=Mastery, 255=Unknown)
        school: u8,
        page: s32,
        sounded-page: s32,
        page-count: s32,
        built-revision: s32,
        dirty: bool,
        content-entity: u64,
        left-corner: u64,
        right-corner: u64,
        minimized: bool,
    }

    /// `cuo:gump/split-menu`
    record split-menu-window {
        serial: u32,
        max-amount: s32,
        slider: u64,
        text: u64,
        ok: u64,
        last-slider: s32,
        last-text: string,
        graphic: u16,
        hue: u16,
        source-ui-entity: u64,
        source-container: u32,
        original-graphic: u16,
        original-hue: u16,
        original-amount: u16,
        original-x: u16,
        original-y: u16,
        original-z: s8,
        original-container: u32,
        original-grid-index: u8,
        original-from-slot: bool,
    }

    /// `cuo:gump/tip-notice`
    record tip-notice-window {
        tip-serial: u16,
        special-height: s32,
        width: f32,
        mid-entity: u64,
        bottom-entity: u64,
        expander-entity: u64,
        prev-entity: u64,
        next-entity: u64,
    }

    /// `cuo:gump/trade`
    record trade-window {
        serial: u32,
        id1: u32,
        id2: u32,
        im-accepting: bool,
        he-is-accepting: bool,
        is-new: bool,
    }

    /// `cuo:player/move-request`
    record mod-move-request {
        /// enum Direction (0=North, 1=Right, 2=East, 3=Down, 4=South, 5=Left, 6=West, 7=Up, 7=Mask, 128=Running, 237=NONE)
        direction: u8,
        run: bool,
        sequence: u8,
    }

    /// `PartyMember`
    record party-member {
        serial: u32,
        name: string,
    }

    /// `cuo:player/party`
    record party {
        leader: u32,
        members: list<party-member>,
        in-party: bool,
        can-loot: bool,
    }

    /// `Spellbook`
    record spellbook {
        serial: u32,
        /// enum SpellBookType (0=Magery, 1=Necromancy, 2=Chivalry, 4=Bushido, 5=Ninjitsu, 6=Spellweaving, 7=Mysticism, 8=Mastery, 255=Unknown)
        book-type: u8,
        spells: list<s32>,
    }

    /// `cuo:player/spellbook`
    record spellbooks {
        revision: s32,
        books: list<spellbook>,
    }

    /// `PlayerStep`
    record player-step {
        sequence: u8,
        /// enum Direction (0=North, 1=Right, 2=East, 3=Down, 4=South, 5=Left, 6=West, 7=Up, 7=Mask, 128=Running, 237=NONE)
        direction: u8,
        x: u16,
        y: u16,
        z: s8,
    }

    /// `cuo:player/steps`
    record player-steps {
        last-step: f32,
        count: s32,
        sequence: u8,
        resync-sent: bool,
        steps: list<player-step>,
    }

    /// `CharInfo`
    record char-info {
        name: string,
        index: u32,
    }

    /// `TownInfo`
    record town-info {
        index: u8,
        name: string,
        building: string,
        x: u16,
        y: u16,
        z: s8,
