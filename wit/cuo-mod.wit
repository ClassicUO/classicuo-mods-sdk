        racial-book: func(v: racial-book-window) -> entity-builder;
        /// Inserts `cuo:gump/skills`.
        gump-skills: func(v: skills-window) -> entity-builder;
        /// Inserts `cuo:gump/spellbook`.
        spellbook: func(v: spellbook-window) -> entity-builder;
        /// Inserts `cuo:gump/split-menu`.
        split-menu: func(v: split-menu-window) -> entity-builder;
        /// Inserts `cuo:gump/tip-notice`.
        tip-notice: func(v: tip-notice-window) -> entity-builder;
        /// Inserts `cuo:gump/trade`.
        trade: func(v: trade-window) -> entity-builder;
