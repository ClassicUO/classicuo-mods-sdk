/// A ClassicUO mod: the generic ECS contract (tinyecs:modding) plus host functions —
/// data files (`assets`), player actions (`actions`), raw `packets`, storage.
///
/// Game data (entities, components, resources, events) is reached through the ECS with
/// type paths ("cuo:ent/graphic", "cuo:player/hits", ...), listed in
/// docs/modding-reference.md. A curated set of them also has typed records and functions
/// (`types` / `components`, generated at the end of this file); the rest is JSON.
package cuo:modding@0.1.0;

interface host {
    use tinyecs:modding/ecs@0.1.0.{entity};

    /// Where `storage-get` / `storage-set` keep the mod's blob.
    enum scope {
        /// One blob for the mod, shared by every character.
        global,
        /// One blob per character (empty until a character is logged in).
        character,
    }

    /// Writes a line to the client log, prefixed with the mod name.
    log: func(message: string);

    /// Pixel width of `text` in a UO font.
    measure-text: func(font: u16, text: string) -> u32;

    /// The entity of a UO serial (an item or mobile the client knows); none when
    /// unknown.
    resolve-serial: func(serial: u32) -> option<entity>;

    /// The mod's stored blob ("" when nothing was stored).
    storage-get: func(scope: scope) -> string;

    /// Replaces the mod's stored blob. Written to disk immediately.
    storage-set: func(scope: scope, value: string);
}

/// Raw UO packets, both ways. A packet is the full wire bytes, id first. Prefer
/// world data and `actions` when they cover what you need: they keep the client's
/// own state in step. To see / block / rewrite packets, add an observer with the
/// `on-packet` trigger (tinyecs:modding/ecs): incoming = server to client, outgoing =
/// client to server.
interface packets {
    /// Sends a packet to the server, as if the client had sent it.
    send-to-server: func(packet: list<u8>);

    /// Feeds a packet to the client, as if the server had sent it.
    send-to-client: func(packet: list<u8>);
}

/// Outbound WebSocket connections (ws:// or wss://), the same on desktop and in the
/// browser. Binary messages only. Everything is non-blocking: `ws-open` returns at once
/// and connects in the background, messages sent before the connection is up are
/// queued, and a failed connect shows up as `ws-recv` returning none.
interface net {
    /// Opens a connection to `url`. Returns its handle (never 0).
    ws-open: func(url: string) -> u32;

    /// Sends one binary message. False when the connection is closed / unknown.
    ws-send: func(socket: u32, data: list<u8>) -> bool;

    /// The binary messages received since the last call, concatenated in order (empty =
    /// nothing yet); none once the connection is closed (by the peer, a failed connect,
    /// or `ws-close`).
    ws-recv: func(socket: u32) -> option<list<u8>>;

    /// Closes the connection. Unknown handles are ignored.
    ws-close: func(socket: u32);
}

/// Hosts legacy native plugins (Razor / ClassicAssist DLLs) through cuo-host's net472
/// launcher. Every mod gets the real interface (the plugin list comes only from the
/// user's settings.json); on a host that has no launcher, `active` is false, `load` returns
/// 0 and `packet` passes.
///
/// All byte blobs; integers little-endian. Call nothing but `active` unless it is true,
/// and skip every other call when `load` returned 0.
interface legacy-plugins {
    /// A launcher is hosting plugins and this mod may drive them.
    active: func() -> bool;

    /// The client's packet length table: i16 per packet id 0..255 (the raw PacketsTable
    /// values: -1 = variable, length at bytes 1..3 big-endian).
    packet-lengths: func() -> list<u8>;

    /// Loads plugins. `paths` as in settings.json `plugins` (resolved against
    /// <exe dir>/Data/Plugins); empty = the settings.json `plugins` list. The host reads
    /// the UO directory and the cliloc table itself. Returns the plugins loaded.
    load: func(paths: list<string>, client-version: u32, packet-lengths: list<u8>) -> u32;

    /// Runs the plugins' packet hook over a full packet (id first). Verdict: [0] pass,
    /// [1] block, [2, bytes..] forward these bytes instead.
    packet: func(incoming: bool, data: list<u8>) -> list<u8>;

    /// Drains what the plugins asked of the client, as records `[u8 kind][u32 len][payload]`:
    /// 1 inject-to-client (frames) 2 inject-to-server (frames) 3 cast-spell (i32)
    /// 4 request-move (u8 dir, u8 run) 5 set-title (utf8) 6 primary-ability
    /// 7 secondary-ability 8 autowalk (u8 on) 9 walk-to (i32 x, y, z, distance).
    poll: func() -> list<u8>;

    /// A key edge. `key` / `mods` are SDL keycodes / SDL_Keymod bits. False = a plugin
    /// consumed the key.
    hotkey: func(key: s32, mods: s32, pressed: bool) -> bool;

    /// A mouse button press (not left / right) or wheel notch (-1 / 1).
    mouse: func(button: s32, wheel: s32);

    /// 0 = tick (each frame; once per frame is enough). Connect, disconnect and focus
    /// events are raised by the host itself; 5 = closing.
    notify: func(ev: u32);

    /// The player's position, for the plugins' position query.
    player-position: func(has: bool, x: s32, y: s32, z: s32);

    /// Answer for the plugins' autowalk query.
    autowalking: func(on: bool);
}

/// The client's UO data files, read-only. Images come back decoded from the files
/// (not from the GPU), so they work before anything was drawn.
///
/// Conventions: pixels are RGBA8, straight alpha, row-major, `width * height * 4`
/// bytes. Colours are u32 0xAARRGGBB. A `hue` argument is the wire value: 0 = none,
/// 0x8000 bit = partial hue (only grey pixels recoloured).
interface assets {
    use types.{layer};

    enum image-kind {
        /// Land tile art, id 0..0x3FFF (44x44 diamond).
        land,
        /// Item / static art, by graphic.
        art,
        /// Gump image.
        gump,
        /// Land texture (64x64 or 128x128), by tiledata texmap id.
        texmap,
        /// Light shape, 0..99.
        light,
    }

    record size { width: u32, height: u32 }

    record image { width: u32, height: u32, rgba: list<u8> }

    /// Width and height; none when the id is missing.
    image-size: func(kind: image-kind, id: u32) -> option<size>;

    /// Decoded pixels with `hue` applied; none when the id is missing.
    image-pixels: func(kind: image-kind, id: u32, hue: u16) -> option<image>;

    /// Which mobile animation to read. `direction` is a `direction` number 0..7 (north
    /// .. up; the host mirrors the ones UO stores flipped); `action` is the UO action
    /// group.
    record anim-key { body: u16, action: u8, direction: u8 }

    record frame-info {
        width: u32,
        height: u32,
        /// Draw offset: the frame's anchor point relative to its top-left.
        center-x: s32,
        center-y: s32,
    }

    /// Number of frames; none when the body has no such animation.
    anim-frames: func(key: anim-key) -> option<u32>;

    /// Size and anchor of one frame.
    anim-frame: func(key: anim-key, frame: u32) -> option<frame-info>;

    /// Decoded pixels of one frame (already mirrored), with `hue` applied.
    anim-pixels: func(key: anim-key, frame: u32, hue: u16) -> option<image>;

    record static-info {
        name: string,
        %flags: u64,
        weight: u8,
        layer: layer,
        count: s32,
        anim-id: u16,
        hue: u16,
        light-index: u16,
        height: u8,
    }

    record land-info { name: string, %flags: u64, texmap: u16 }

    /// The tiledata row of an item / static graphic.
    static-tile: func(graphic: u16) -> option<static-info>;

    /// The tiledata row of a land tile.
    land-tile: func(id: u16) -> option<land-info>;

    /// The 32-colour ramp of a hue (1-based, as on the wire), dark to light.
    hue-ramp: func(hue: u16) -> option<list<u32>>;

    /// A cliloc by id with its `~n_ARG~` slots filled from `args`; empty when
    /// unknown.
    cliloc: func(id: u32, args: list<string>) -> string;

    /// Map file data only (no items, no house customisation). `map` is the facet
    /// index.
    record land-cell { graphic: u16, z: s8 }
    record static-cell { graphic: u16, z: s8, hue: u16 }

    map-size: func(%map: u8) -> option<size>;
    map-land: func(%map: u8, x: u16, y: u16) -> option<land-cell>;
    map-statics: func(%map: u8, x: u16, y: u16) -> list<static-cell>;

    /// The pieces of a multi (house, boat), offsets relative to its centre.
    record multi-part { graphic: u16, x: s16, y: s16, z: s16 }
    multi: func(id: u16) -> list<multi-part>;

    record skill { index: u16, name: string, has-action: bool }
    skills: func() -> list<skill>;
}

/// What the player can do. Each call goes through the client's own code path (the
/// same one a click or hotkey uses), so the client's state — held item, last target,
/// last object, war mode, the target queue — stays in step with the server. Calls
/// are fire-and-forget; the outcome shows up as world data and events.
///
/// Only primitives are here. Combinations (move every item of a type, target self,
/// bandage self, ...) are SDK helpers built on these.
interface actions {
    use types.{layer, lock as lock-state, stat};

    /// A UO serial (items have the 0x40000000 bit).
    type serial = u32;

    enum direction { north, north-east, east, south-east, south, south-west, west, north-west }
    enum speech-kind { regular, emote, whisper, yell, guild, alliance }
    enum emote { bow, salute }
    enum virtue { honor, sacrifice, valor }
    enum ability { primary, secondary }
    enum window {
        paperdoll, status, journal, skills, backpack, world-map, minimap, options,
        buffs, combat-book, party, guild, quest, logout,
    }

    record point { x: u16, y: u16, z: s8 }

    variant destination {
        /// Into a container; the server picks the slot.
        container(serial),
        /// Into a container at a slot (x, y).
        container-at(tuple<serial, u16, u16>),
        /// On the ground.
        ground(point),
    }

    // ── items ──
    double-click: func(target: serial);
    single-click: func(target: serial);
    /// Picks the item up onto the cursor (amount 0 = whole stack).
    pick-up: func(item: serial, amount: u16);
    /// Drops the item held on the cursor.
    drop: func(to: destination);
    /// Equips the item held on the cursor.
    equip: func(layer: layer, mobile: serial);
    /// Pick up + drop in one step, without touching the cursor.
    move-item: func(item: serial, amount: u16, to: destination);
    /// Pick up + equip in one step.
    wear: func(item: serial, layer: layer, mobile: serial);
    /// Uses `item` on `target` (bandages, keys, ...).
    use-item-on: func(item: serial, target: serial);
    equip-last-weapon: func();
    rename: func(mobile: serial, name: string);
    request-properties: func(target: serial);
    close-container: func(container: serial);

    // ── movement ──
    walk: func(dir: direction, run: bool);
    /// Pathfinds to a tile.
    walk-to: func(at: point);
    /// Like `walk-to`, stopping once within `distance` tiles of `at`.
    walk-to-within: func(at: point, distance: u32);
    cancel-walk-to: func();
    open-door: func();
    resync: func();

    // ── combat ──
    set-war-mode: func(on: bool);
    attack: func(mobile: serial);
    /// Toggles the weapon's special ability.
    use-ability: func(which: ability);
    clear-ability: func();
    toggle-flying: func();

    // ── targeting ──
    /// Answers the open target cursor, or queues the answer for the next one.
    target-object: func(target: serial);
    target-location: func(at: point, graphic: u16);
    target-cancel: func();
    clear-target-queue: func();
    /// Shows a client-side target cursor; the pick arrives as `cuo:target/local-result`.
    request-target: func(prompt: string);

    // ── spells, skills, virtues ──
    cast-spell: func(id: u16);
    /// `kind` is a `spell-book-type` number (0 magery, 1 necromancy, ...).
    open-spellbook: func(kind: u8);
    use-skill: func(index: u16);
    set-skill-lock: func(index: u16, state: lock-state);
    set-stat-lock: func(which: stat, state: lock-state);
    invoke-virtue: func(which: virtue);
    emote-action: func(which: emote);

    // ── speech ──
    say: func(text: string, kind: speech-kind, hue: option<u16>);
    /// To the whole party, or one member.
    party-say: func(text: string, to: option<serial>);

    // ── gumps, menus, prompts ──
    gump-reply: func(gump: u32, button: s32, switches: list<u32>, texts: list<tuple<u16, string>>);
    gump-close: func(gump: u32);
    request-context-menu: func(target: serial);
    context-menu-reply: func(target: serial, index: u16);
    prompt-reply: func(text: string);
    prompt-cancel: func();
    menu-reply: func(menu: serial, menu-id: u16, index: u16, graphic: u16, hue: u16);
    text-entry-reply: func(dialog: serial, parent-id: u8, button: u8, text: string, ok: bool);
    dye-reply: func(tub: serial, graphic: u16, hue: u16);
    help-request: func();

    // ── party ──
    /// The server answers with a target cursor.
    party-invite: func();
    /// None = pick by target.
    party-remove: func(member: option<serial>);
    party-accept: func(leader: serial);
    party-decline: func(leader: serial);
    party-set-loot: func(shareable: bool);

    // ── trade, vendors ──
    trade-accept: func(container: serial, accepted: bool);
    trade-cancel: func(container: serial);
    trade-set-gold: func(container: serial, gold: u32, platinum: u32);
    vendor-buy: func(vendor: serial, items: list<tuple<serial, u16>>);
    vendor-sell: func(vendor: serial, items: list<tuple<serial, u16>>);

    // ── requests, client ──
    /// None = yourself.
    request-status: func(mobile: option<serial>);
    request-skills: func(mobile: option<serial>);
    /// `target` picks whose paperdoll / status; none = yours.
    open-window: func(w: window, target: option<serial>);
    close-window: func(w: window);
    set-view-range: func(range: u8);
    logout: func();
    /// Sets the OS window title to `title` (empty = the client's default). The client
    /// rewrites it when the character or shard changes.
    set-window-title: func(title: string);
}

// ── typed components: generated by tools/mod-typegen (make gen-mod-sdk); do not edit until the end marker ──

/// Game components / resources / events: one record per type (and every type it reaches).
/// A record holds the payload's members, kebab-cased; members the host computes are left
/// out; an enum numbered 0..n-1 is a WIT enum. Every value a mod reads or writes is one of
/// these, through `components` (tinyecs:modding/ecs carries no values).
interface types {
    use tinyecs:modding/ecs@0.1.0.{entity};

    /// `cuo:player/hits`
    record hits {
        value: u16,
        max-value: u16,
    }

    /// `cuo:player/mana`
    record mana {
        value: u16,
        max-value: u16,
    }

    /// `cuo:player/stamina`
    record stamina {
        value: u16,
        max-value: u16,
    }

    /// `cuo:player/data`
    record player-data {
        str: u16,
        str-max: u16,
        dex: u16,
        dex-max: u16,
        int: u16,
        int-max: u16,
        stats-cap: s16,
        followers: u8,
        followers-max: u8,
        weight: u16,
        weight-max: u16,
        gold: u32,
        thithing-points: u32,
        luck: u16,
        damage-min: s16,
        damage-max: s16,
        physical-res: s16,
        fire-res: s16,
        cold-res: s16,
        poison-res: s16,
        energy-res: s16,
        is-female: bool,
        /// enum RaceType (1=HUMAN, 2=ELF, 3=GARGOYLE)
        race: u8,
        max-physical-res: s16,
        max-fire-res: s16,
        max-cold-res: s16,
        max-poison-res: s16,
        max-energy-res: s16,
        defense-chance-inc: s16,
        max-defense-chance-inc: s16,
        hit-chance-inc: s16,
        swing-speed-inc: s16,
        damage-inc: s16,
        lower-reagent-cost: s16,
        spell-damage-inc: s16,
        faster-cast-recovery: s16,
        faster-casting: s16,
        lower-mana-cost: s16,
    }

    /// `cuo:ent/serial`
    record serial {
        value: u32,
    }

    /// `cuo:ent/graphic`
    record graphic {
        value: u16,
    }

    /// `cuo:ent/hue`
    record hue {
        value: u16,
    }

    /// `cuo:ent/world-position`
    record world-position {
        x: u16,
        y: u16,
        z: s8,
    }

    /// `NotorietyFlag`
    enum notoriety-flag { unknown, innocent, ally, gray, criminal, enemy, murderer, invulnerable }

    /// `cuo:ent/notoriety`
    record notoriety {
        value: notoriety-flag,
    }

    /// `cuo:ent/name`
    record entity-name {
        value: string,
    }

    /// `cuo:ent/amount`
    record amount {
        value: s32,
    }

    /// `Display`
    enum display { flex, none }

    /// `PositionType`
    enum position-type { relative, absolute }

    /// `Overflow`
    enum overflow { visible, clip, scroll }

    /// `FlexDirection`
    enum flex-direction { row, column }

    /// `JustifyContent`
    enum justify-content { start, center, end }

    /// `AlignItems`
    enum align-items { start, center, end }

    /// `ValType`
    enum val-type { auto, px, percent, grow }

    /// `Val`
    record val {
        %type: val-type,
        value: f32,
    }

    /// `UiRect`
    record ui-rect {
        left: val,
        right: val,
        top: val,
        bottom: val,
    }

    /// `cuo:ui/node`
    record node {
        display: display,
        position-type: position-type,
        overflow: overflow,
        flex-direction: flex-direction,
        justify-content: justify-content,
        align-items: align-items,
        width: val,
        height: val,
        min-width: val,
        min-height: val,
        max-width: val,
        max-height: val,
        left: val,
        top: val,
        right: val,
        bottom: val,
        padding: ui-rect,
        border: ui-rect,
        gap: val,
        aspect-ratio: f32,
    }

    /// `cuo:ui/text`
    record text {
        value: string,
    }

    /// `cuo:ui/text-font`
    record text-font {
        font-id: u16,
        size: u16,
    }

    /// `Color`
    record color {
        r: f32,
        g: f32,
        b: f32,
        a: f32,
    }

    /// `cuo:ui/text-color`
    record text-color {
        value: color,
    }

    /// `cuo:ui/bg-color`
    record background-color {
        value: color,
    }

    /// `cuo:ui/border-radius`
    record border-radius {
        top-left: f32,
        top-right: f32,
        bottom-left: f32,
        bottom-right: f32,
    }

    /// `cuo:ecs/child-of`
    record child-of {
        parent: entity,
    }

    /// `cuo:ui/global-z`
    record global-z-index {
        value: s32,
    }

    /// `InteractionState`
    enum interaction-state { none, hovered, pressed }

    /// `cuo:ui/interaction`
    record interaction {
        state: interaction-state,
    }

    /// `cuo:input/mouse`
    record mouse-input {
        x: f32,
        y: f32,
        left: bool,
        right: bool,
        middle: bool,
        x1: bool,
        x2: bool,
        wheel: f32,
        left-pressed: bool,
        left-released: bool,
        left-double: bool,
        right-pressed: bool,
        right-released: bool,
        middle-pressed: bool,
        middle-released: bool,
        x1-pressed: bool,
        x2-pressed: bool,
    }

    /// `cuo:input/keyboard`
    record keyboard-input {
        pressed: list<s32>,
        pressed-once: list<s32>,
    }

    /// `ChatKind`
    enum chat-kind { overhead, system }

    /// `cuo:chat/message`
    record chat-message {
        serial: u32,
        text: string,
        name: string,
        hue: u16,
        font: u8,
        is-unicode: bool,
        /// enum MessageType (0=Regular, 1=System, 2=Emote, 3=Limit3Spell, 6=Label, 7=Focus, 8=Whisper, 9=Yell, 10=Spell, 13=Guild, 14=Alliance, 15=Command, 16=GmChat, 192=Encoded, 255=Party)
        message-type: u8,
        time: f32,
        kind: chat-kind,
    }

    /// `cuo:chat/prompt`
    record prompt-opened-event {
        serial: u32,
        prompt-id: u32,
        unicode: bool,
        text: string,
    }

    /// `cuo:engine/time`
    record time {
        total: f32,
        frame: f32,
    }

    /// `cuo:ent/equipment`
    record equipment-slots {
        serials: list<u32>,
    }

    /// `cuo:ent/facing`
    record facing {
        /// enum Direction (0=North, 1=Right, 2=East, 3=Down, 4=South, 5=Left, 6=West, 7=Up, 7=Mask, 128=Running, 237=NONE)
        value: u8,
    }

    /// `OplLine`
    record opl-line {
        cliloc: s32,
        args: string,
        text: string,
    }

    /// `cuo:ent/properties`
    record entity-properties {
        serial: u32,
        revision: u32,
        name: string,
        lines: list<opl-line>,
    }

    /// `cuo:ent/server-flags`
    record server-flags {
        /// enum Flags (0=None, 1=Frozen, 2=Female, 4=Poisoned, 4=Flying, 8=YellowBar, 16=IgnoreMobiles, 32=Movable, 64=WarMode, 128=Hidden)
        value: u8,
    }

    /// `cuo:ent/slot-position`
    record container-slot-position {
        x: u16,
        y: u16,
        grid-index: u8,
    }

    /// `cuo:game/context`
    record game-context {
        player-serial: u32,
        player-name: string,
        %map: s32,
        season: u8,
        client-version: u32,
        use-old-status-gump: bool,
    }

    /// `cuo:game/settings`
    record game-settings {
        grid-loot-type: s32,
        skip-empty-corpse: bool,
        auto-open-corpses: bool,
        auto-open-corpse-range: s32,
        corpse-open-options: s32,
        double-click-to-loot-inside-containers: bool,
        hold-shift-to-split-stack: bool,
        relative-drag-and-drop-items: bool,
        speech-hue: u16,
        always-run: bool,
        highlight-game-objects: bool,
    }

    /// `GameStateKind`
    enum game-state-kind { loading, login-screen, server-selection, character-selection, character-creation, login-error, game-screen }

    /// `cuo:game/state`
    record game-state {
        current: game-state-kind,
    }

    /// `cuo:gump/container`
    record container-window {
        serial: u32,
    }

    /// `cuo:gump/container-closed`
    record container-closed-event {
        serial: u32,
        user-initiated: bool,
    }

    /// `cuo:gump/container-opened`
    record container-opened-event {
        serial: u32,
        graphic: u16,
    }

    /// `ContainerPosition`
    record container-position {
        serial: u32,
        x: s32,
        y: s32,
    }

    /// `cuo:gump/container-positions`
    record container-positions {
        saved: list<container-position>,
    }

    /// `ContainerSlotAction`
    enum container-slot-action { add, remove }

    /// `cuo:gump/container-slot`
    record container-slot-event {
        action: container-slot-action,
        container-serial: u32,
        item-serial: u32,
        graphic: u16,
        hue: u16,
        x: u16,
        y: u16,
        amount: u16,
    }

    /// `cuo:gump/container-tag`
    record container-gump-tag {
        graphic: u16,
        original-graphic: u16,
        scale: f32,
        bounds-x: s32,
        bounds-y: s32,
        bounds-w: s32,
        bounds-h: s32,
    }

    /// `ContextMenuEntry`
    record context-menu-entry {
        index: u16,
        cliloc: s32,
        text: string,
        /// enum ContextMenuFlags (0=None, 1=Disabled, 2=Arrow, 32=Hued)
        %flags: u16,
        hue: u16,
    }

    /// `cuo:gump/context-menu`
    record context-menu-event {
        serial: u32,
        entries: list<context-menu-entry>,
    }

    /// `cuo:gump/grid-container`
    record grid-container-window {
        serial: u32,
    }

    /// `cuo:gump/grid-loot`
    record grid-loot-window {
        corpse-serial: u32,
        corpse-entity: u64,
        content-sig: s32,
    }

    /// `cuo:gump/health-bar`
    record health-bar-window {
        serial: u32,
        is-player: bool,
        out-of-range: bool,
        hp-requested: bool,
        was-dead: bool,
        in-party: bool,
        name-editable: bool,
    }

    /// `ServerGumpButton`
    record server-gump-button {
        id: s32,
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }

    /// `ServerGumpTextEntry`
    record server-gump-text-entry {
        id: u16,
        text: string,
    }

    /// `ServerGumpSwitch`
    record server-gump-switch {
        id: u32,
        checked: bool,
        is-radio: bool,
        group: s32,
    }

    /// `cuo:gump/server`
    record server-gump {
        serial: u32,
        gump-id: u32,
        page: s32,
        x: s32,
        y: s32,
        layout: list<string>,
        texts: list<string>,
        buttons: list<server-gump-button>,
        text-entries: list<server-gump-text-entry>,
        switches: list<server-gump-switch>,
    }

    /// `cuo:input/consume`
    record input-consume {
        mouse: u8,
        key: u32,
    }

    /// `HostHotkey`
    record host-hotkey {
        key: s32,
        ctrl: bool,
        shift: bool,
        alt: bool,
        action: string,
    }

    /// `cuo:input/host-hotkeys`
    record host-hotkeys {
        hotkeys: list<host-hotkey>,
    }

    /// `cuo:input/hotkey`
    record mod-hotkey-fired {
        name: string,
        key: s32,
        mouse: s32,
        ctrl: bool,
        shift: bool,
        alt: bool,
        from-mod: bool,
    }

    /// `ModHotkeyBinding`
    record mod-hotkey-binding {
        name: string,
        key: s32,
        mouse: s32,
        ctrl: bool,
        shift: bool,
        alt: bool,
        consume: bool,
    }

    /// `cuo:input/mod-hotkeys`
    record mod-hotkey-bindings {
        bindings: list<mod-hotkey-binding>,
        consume-keys: bool,
    }

    /// `cuo:input/world-single-click`
    record world-single-click {
        serial: u32,
        at-ms: u64,
    }

    /// `cuo:item/drop-sent`
    record item-drop-sent {
        serial: u32,
        x: u16,
        y: u16,
        z: s8,
        container: u32,
    }

    /// `ItemMoveOutcome`
    enum item-move-outcome { accepted, denied, end-dragging }

    /// `cuo:item/move-result`
    record item-move-result {
        %result: item-move-outcome,
        code: u8,
    }

    /// `ModOptionKind`
    enum mod-option-kind { toggle, slider, stepper, cycle }

    /// `ModOption`
    record mod-option {
        key: string,
        label: string,
        group: string,
        keywords: string,
        kind: mod-option-kind,
        min: s32,
        max: s32,
        step: s32,
        default: s32,
        choices: list<string>,
    }

    /// `cuo:options/schema`
    record mod-options-schema {
        options: list<mod-option>,
    }

    /// `ModOptionValue`
    record mod-option-value {
        key: string,
        value: s32,
    }

    /// `cuo:options/values`
    record mod-options-values {
        values: list<mod-option-value>,
    }

    /// `PlayerBuff`
    record player-buff {
        %type: s32,
        graphic: u16,
        expires-at: f32,
        text: string,
    }

    /// `cuo:player/buffs`
    record player-buffs {
        buffs: list<player-buff>,
    }

    /// `Layer`
    enum layer { invalid, one-handed, two-handed, shoes, pants, shirt, helmet, gloves, ring, talisman, necklace, hair, waist, torso, bracelet, face, beard, tunic, earrings, arms, cloak, backpack, robe, skirt, legs, mount, shop-buy-restock, shop-buy, shop-sell, bank }

    /// `Vector2`
    record vector2 {
        x: f32,
        y: f32,
    }

    /// `cuo:player/grabbed-item`
    record grabbed-item {
        is-active: bool,
        serial: u32,
        graphic: u16,
        hue: u16,
        amount: s32,
        source-ui-entity: u64,
        original-graphic: u16,
        original-hue: u16,
        original-amount: u16,
        original-x: u16,
        original-y: u16,
        original-z: s8,
        original-container: u32,
        original-grid-index: u8,
        original-from-slot: bool,
        original-layer: layer,
        pending-drop: bool,
        drop-target-serial: u32,
        failed-drop: bool,
        mouse-offset: vector2,
    }

    /// `Lock`
    enum lock { up, down, locked }

    /// `PlayerSkill`
    record player-skill {
        index: s32,
        value: u16,
        base: u16,
        cap: u16,
        lock: lock,
    }

    /// `cuo:player/skills`
    record player-skills {
        has-data: bool,
        skills: list<player-skill>,
    }

    /// `cuo:player/stat-locks`
    record stat-locks {
        str: lock,
        dex: lock,
        int: lock,
    }

    /// `cuo:target/local-result`
    record local-target-result-event {
        entity: u64,
        serial: u32,
        graphic: u16,
        x: u16,
        y: u16,
        z: s8,
        cancelled: bool,
    }

    /// `TargetMode`
    enum target-mode { object, position, multi }

    /// `TargetType`
    enum target-type { neutral, harmful, beneficial, cancel }

    /// `cuo:target/state`
    record targeting-state {
        is-targeting: bool,
        mode: target-mode,
        local: bool,
        cursor-id: u32,
        cursor-type: target-type,
        just-targeted: bool,
        multi-id: u16,
        multi-offset-x: s16,
        multi-offset-y: s16,
        multi-offset-z: s16,
        multi-hue: u16,
        preview-built-id: u16,
        has-local-result: bool,
        local-serial: u32,
        local-graphic: u16,
        local-x: u16,
        local-y: u16,
        local-z: s8,
        local-cancelled: bool,
    }

