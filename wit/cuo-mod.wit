    set-slot-position: func(q: borrow<query>, e: entity, term: u8, v: container-slot-position);

    /// `cuo:gump/container` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:gump/container`.
    column-container: func(q: borrow<query>, term: u8) -> list<container-window>;
    /// Writes `cuo:gump/container` back through the `mut` reading term `term`.
    set-container: func(q: borrow<query>, e: entity, term: u8, v: container-window);

    /// `cuo:gump/container-tag` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:gump/container-tag`.
    column-container-tag: func(q: borrow<query>, term: u8) -> list<container-gump-tag>;
    /// Writes `cuo:gump/container-tag` back through the `mut` reading term `term`.
    set-container-tag: func(q: borrow<query>, e: entity, term: u8, v: container-gump-tag);

    /// `cuo:gump/grid-container` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:gump/grid-container`.
    column-grid-container: func(q: borrow<query>, term: u8) -> list<grid-container-window>;
    /// Writes `cuo:gump/grid-container` back through the `mut` reading term `term`.
