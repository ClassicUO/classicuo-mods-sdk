/// A ClassicUO mod: the generic ECS contract (tinyecs:modding) plus host functions —
/// data files (`assets`), player actions (`actions`), raw `packets`, storage.
///
/// Game data (entities, components, resources, events) is reached through the ECS with
/// type paths ("cuo:ent/graphic", "cuo:player/hits", ...), listed in
/// docs/modding-reference.md. A curated set of them also has typed records and functions
/// (`types` / `components`, generated at the end of this file); the rest is JSON.
package cuo:modding@0.1.0;

interface host {
    use tinyecs:modding/ecs@0.1.0.{entity, json};

    /// Where `storage-get` / `storage-set` keep the mod's blob.
    enum scope {
        /// One blob for the mod, shared by every character.
        global,
        /// One blob per character (empty until a character is logged in).
        character,
    }

    /// Writes a line to the client log, prefixed with the mod name.
    log: func(message: string);

    /// Pixel width of `text` in a UO font.
    measure-text: func(font: u16, text: string) -> u32;

    /// The entity of a UO serial (an item or mobile the client knows); none when
    /// unknown.
    resolve-serial: func(serial: u32) -> option<entity>;

    /// The mod's stored blob ("" when nothing was stored).
    storage-get: func(scope: scope) -> string;

    /// Replaces the mod's stored blob. Written to disk immediately.
    storage-set: func(scope: scope, value: string);
}

/// Raw UO packets, both ways. A packet is the full wire bytes, id first. Prefer
/// world data and `actions` when they cover what you need: they keep the client's
/// own state in step. To see / block / rewrite packets, add an observer with the
/// `on-packet` trigger (tinyecs:modding/ecs): incoming = server to client, outgoing =
/// client to server.
interface packets {
    /// Sends a packet to the server, as if the client had sent it.
    send-to-server: func(packet: list<u8>);

    /// Feeds a packet to the client, as if the server had sent it.
    send-to-client: func(packet: list<u8>);
}

/// The client's UO data files, read-only. Images come back decoded from the files
/// (not from the GPU), so they work before anything was drawn.
///
/// Conventions: pixels are RGBA8, straight alpha, row-major, `width * height * 4`
/// bytes. Colours are u32 0xAARRGGBB. A `hue` argument is the wire value: 0 = none,
/// 0x8000 bit = partial hue (only grey pixels recoloured).
interface assets {
    enum image-kind {
        /// Land tile art, id 0..0x3FFF (44x44 diamond).
        land,
        /// Item / static art, by graphic.
        art,
        /// Gump image.
        gump,
        /// Land texture (64x64 or 128x128), by tiledata texmap id.
        texmap,
        /// Light shape, 0..99.
        light,
    }

    record size { width: u32, height: u32 }

    record image { width: u32, height: u32, rgba: list<u8> }

    /// Width and height; none when the id is missing.
    image-size: func(kind: image-kind, id: u32) -> option<size>;

    /// Decoded pixels with `hue` applied; none when the id is missing.
    image-pixels: func(kind: image-kind, id: u32, hue: u16) -> option<image>;

    /// Which mobile animation to read. `direction` is 0..7 (the host mirrors the
    /// ones UO stores flipped); `action` is the UO action group.
    record anim-key { body: u16, action: u8, direction: u8 }

    record frame-info {
        width: u32,
        height: u32,
        /// Draw offset: the frame's anchor point relative to its top-left.
        center-x: s32,
        center-y: s32,
    }

    /// Number of frames; none when the body has no such animation.
    anim-frames: func(key: anim-key) -> option<u32>;

    /// Size and anchor of one frame.
    anim-frame: func(key: anim-key, frame: u32) -> option<frame-info>;

    /// Decoded pixels of one frame (already mirrored), with `hue` applied.
    anim-pixels: func(key: anim-key, frame: u32, hue: u16) -> option<image>;

    record static-info {
        name: string,
        %flags: u64,
        weight: u8,
        layer: u8,
        count: s32,
        anim-id: u16,
        hue: u16,
        light-index: u16,
        height: u8,
    }

    record land-info { name: string, %flags: u64, texmap: u16 }

    /// The tiledata row of an item / static graphic.
    static-tile: func(graphic: u16) -> option<static-info>;

    /// The tiledata row of a land tile.
    land-tile: func(id: u16) -> option<land-info>;

    /// The 32-colour ramp of a hue (1-based, as on the wire), dark to light.
    hue-ramp: func(hue: u16) -> option<list<u32>>;

    /// A cliloc by id with its `~n_ARG~` slots filled from `args`; empty when
    /// unknown.
    cliloc: func(id: u32, args: list<string>) -> string;

    /// Map file data only (no items, no house customisation). `map` is the facet
    /// index.
    record land-cell { graphic: u16, z: s8 }
    record static-cell { graphic: u16, z: s8, hue: u16 }

    map-size: func(%map: u8) -> option<size>;
    map-land: func(%map: u8, x: u16, y: u16) -> option<land-cell>;
    map-statics: func(%map: u8, x: u16, y: u16) -> list<static-cell>;

    /// The pieces of a multi (house, boat), offsets relative to its centre.
    record multi-part { graphic: u16, x: s16, y: s16, z: s16 }
    multi: func(id: u16) -> list<multi-part>;

    record skill { index: u16, name: string, has-action: bool }
    skills: func() -> list<skill>;
}

/// What the player can do. Each call goes through the client's own code path (the
/// same one a click or hotkey uses), so the client's state — held item, last target,
/// last object, war mode, the target queue — stays in step with the server. Calls
/// are fire-and-forget; the outcome shows up as world data and events.
///
/// Only primitives are here. Combinations (move every item of a type, target self,
/// bandage self, ...) are SDK helpers built on these.
interface actions {
    /// A UO serial (items have the 0x40000000 bit).
    type serial = u32;

    enum direction { north, north-east, east, south-east, south, south-west, west, north-west }
    enum speech-kind { regular, emote, whisper, yell, guild, alliance }
    enum lock-state { up, down, locked }
    enum stat { str, dex, int }
    enum virtue { honor, sacrifice, valor }
    enum ability { primary, secondary }
    enum window {
        paperdoll, status, journal, skills, backpack, world-map, minimap, options,
        buffs, combat-book, party, guild, quest, logout,
    }

    record point { x: u16, y: u16, z: s8 }

    variant destination {
        /// Into a container; the server picks the slot.
        container(serial),
        /// Into a container at a slot (x, y).
        container-at(tuple<serial, u16, u16>),
        /// On the ground.
        ground(point),
    }

    // ── items ──
    double-click: func(target: serial);
    single-click: func(target: serial);
    /// Picks the item up onto the cursor (amount 0 = whole stack).
    pick-up: func(item: serial, amount: u16);
    /// Drops the item held on the cursor.
    drop: func(to: destination);
    /// Equips the item held on the cursor.
    equip: func(layer: u8, mobile: serial);
    /// Pick up + drop in one step, without touching the cursor.
    move-item: func(item: serial, amount: u16, to: destination);
    /// Pick up + equip in one step.
    wear: func(item: serial, layer: u8, mobile: serial);
    /// Uses `item` on `target` (bandages, keys, ...).
    use-item-on: func(item: serial, target: serial);
    equip-last-weapon: func();
    rename: func(mobile: serial, name: string);
    request-properties: func(target: serial);
    close-container: func(container: serial);

    // ── movement ──
    walk: func(dir: direction, run: bool);
    /// Pathfinds to a tile.
    walk-to: func(at: point);
    cancel-walk-to: func();
    open-door: func();
    resync: func();

    // ── combat ──
    set-war-mode: func(on: bool);
    attack: func(mobile: serial);
    /// Toggles the weapon's special ability.
    use-ability: func(which: ability);
    clear-ability: func();
    toggle-flying: func();

    // ── targeting ──
    /// Answers the open target cursor, or queues the answer for the next one.
    target-object: func(target: serial);
    target-location: func(at: point, graphic: u16);
    target-cancel: func();
    clear-target-queue: func();
    /// Shows a client-side target cursor; the pick arrives as `cuo:target/local-result`.
    request-target: func(prompt: string);

    // ── spells, skills, virtues ──
    cast-spell: func(id: u16);
    open-spellbook: func(kind: u8);
    use-skill: func(index: u16);
    set-skill-lock: func(index: u16, state: lock-state);
    set-stat-lock: func(which: stat, state: lock-state);
    invoke-virtue: func(which: virtue);
    /// "bow" or "salute".
    emote-action: func(name: string);

    // ── speech ──
    say: func(text: string, kind: speech-kind, hue: option<u16>);
    /// To the whole party, or one member.
    party-say: func(text: string, to: option<serial>);

    // ── gumps, menus, prompts ──
    gump-reply: func(gump: u32, button: s32, switches: list<u32>, texts: list<tuple<u16, string>>);
    gump-close: func(gump: u32);
    request-context-menu: func(target: serial);
    context-menu-reply: func(target: serial, index: u16);
    prompt-reply: func(text: string);
    prompt-cancel: func();
    menu-reply: func(menu: serial, menu-id: u16, index: u16, graphic: u16, hue: u16);
    text-entry-reply: func(dialog: serial, parent-id: u8, button: u8, text: string, ok: bool);
    dye-reply: func(tub: serial, graphic: u16, hue: u16);
    help-request: func();

    // ── party ──
    /// The server answers with a target cursor.
    party-invite: func();
    /// None = pick by target.
    party-remove: func(member: option<serial>);
    party-accept: func(leader: serial);
    party-decline: func(leader: serial);
    party-set-loot: func(shareable: bool);

    // ── trade, vendors ──
    trade-accept: func(container: serial, accepted: bool);
    trade-cancel: func(container: serial);
    trade-set-gold: func(container: serial, gold: u32, platinum: u32);
    vendor-buy: func(vendor: serial, items: list<tuple<serial, u16>>);
    vendor-sell: func(vendor: serial, items: list<tuple<serial, u16>>);

    // ── requests, client ──
    /// None = yourself.
    request-status: func(mobile: option<serial>);
    request-skills: func(mobile: option<serial>);
    /// `target` picks whose paperdoll / status; none = yours.
    open-window: func(w: window, target: option<serial>);
    close-window: func(w: window);
    set-view-range: func(range: u8);
    logout: func();
}

// ── typed components: generated by tools/mod-typegen (make gen-mod-sdk); do not edit until the end marker ──

/// Game components / resources / events with a typed API: one record per type (and every
/// type it reaches). A record holds the payload's JSON members, kebab-cased; members the
/// host computes are left out; an enum numbered 0..n-1 is a WIT enum. Every other type
/// path keeps the JSON path (`query.rows`, `commands.insert`, `commands.send`).
interface types {
    use tinyecs:modding/ecs@0.1.0.{entity};

    /// `cuo:player/hits`
    record hits {
        value: u16,
        max-value: u16,
    }

    /// `cuo:player/mana`
    record mana {
        value: u16,
        max-value: u16,
    }

    /// `cuo:player/stamina`
    record stamina {
        value: u16,
        max-value: u16,
    }

    /// `cuo:player/data`
    record player-data {
        str: u16,
        str-max: u16,
        dex: u16,
        dex-max: u16,
        int: u16,
        int-max: u16,
        stats-cap: s16,
        followers: u8,
        followers-max: u8,
        weight: u16,
        weight-max: u16,
        gold: u32,
        thithing-points: u32,
        luck: u16,
        damage-min: s16,
        damage-max: s16,
        physical-res: s16,
        fire-res: s16,
        cold-res: s16,
        poison-res: s16,
        energy-res: s16,
        is-female: bool,
        /// enum RaceType (1=HUMAN, 2=ELF, 3=GARGOYLE)
        race: u8,
        max-physical-res: s16,
        max-fire-res: s16,
        max-cold-res: s16,
        max-poison-res: s16,
        max-energy-res: s16,
        defense-chance-inc: s16,
        max-defense-chance-inc: s16,
        hit-chance-inc: s16,
        swing-speed-inc: s16,
        damage-inc: s16,
        lower-reagent-cost: s16,
        spell-damage-inc: s16,
        faster-cast-recovery: s16,
        faster-casting: s16,
        lower-mana-cost: s16,
    }

    /// `cuo:ent/serial`
    record serial {
        value: u32,
    }

    /// `cuo:ent/graphic`
    record graphic {
        value: u16,
    }

    /// `cuo:ent/hue`
    record hue {
        value: u16,
    }

    /// `cuo:ent/world-position`
    record world-position {
        x: u16,
        y: u16,
        z: s8,
    }

    /// `NotorietyFlag`
    enum notoriety-flag { unknown, innocent, ally, gray, criminal, enemy, murderer, invulnerable }

    /// `cuo:ent/notoriety`
    record notoriety {
        value: notoriety-flag,
    }

    /// `cuo:ent/name`
    record entity-name {
        value: string,
    }

    /// `cuo:ent/amount`
    record amount {
        value: s32,
    }

    /// `Display`
    enum display { flex, none }

    /// `PositionType`
    enum position-type { relative, absolute }

    /// `Overflow`
    enum overflow { visible, clip, scroll }

    /// `FlexDirection`
    enum flex-direction { row, column }

    /// `JustifyContent`
    enum justify-content { start, center, end }

    /// `AlignItems`
    enum align-items { start, center, end }

    /// `ValType`
    enum val-type { auto, px, percent, grow }

    /// `Val`
    record val {
        %type: val-type,
        value: f32,
    }

    /// `UiRect`
    record ui-rect {
        left: val,
        right: val,
        top: val,
        bottom: val,
    }

    /// `cuo:ui/node`
    record node {
        display: display,
        position-type: position-type,
        overflow: overflow,
        flex-direction: flex-direction,
        justify-content: justify-content,
        align-items: align-items,
        width: val,
        height: val,
        min-width: val,
        min-height: val,
        max-width: val,
        max-height: val,
        left: val,
        top: val,
        right: val,
        bottom: val,
        padding: ui-rect,
        border: ui-rect,
        gap: val,
        aspect-ratio: f32,
    }

    /// `cuo:ui/text`
    record text {
        value: string,
    }

    /// `cuo:ui/text-font`
    record text-font {
        font-id: u16,
        size: u16,
    }

    /// `Color`
    record color {
        r: f32,
        g: f32,
        b: f32,
        a: f32,
    }

    /// `cuo:ui/text-color`
    record text-color {
        value: color,
    }

    /// `cuo:ui/bg-color`
    record background-color {
        value: color,
    }

    /// `cuo:ui/border-radius`
    record border-radius {
        top-left: f32,
        top-right: f32,
        bottom-left: f32,
        bottom-right: f32,
    }

    /// `cuo:ecs/child-of`
    record child-of {
        parent: entity,
    }

    /// `cuo:ui/global-z`
    record global-z-index {
        value: s32,
    }

    /// `cuo:ui/interaction`
    record interaction {
        state: u8,
    }

    /// `cuo:input/mouse`
    record mouse-input {
        x: f32,
        y: f32,
        left: bool,
        right: bool,
        middle: bool,
        x1: bool,
        x2: bool,
        wheel: f32,
        left-pressed: bool,
        left-released: bool,
        left-double: bool,
        right-pressed: bool,
        right-released: bool,
        middle-pressed: bool,
        middle-released: bool,
        x1-pressed: bool,
        x2-pressed: bool,
    }

    /// `cuo:input/keyboard`
    record keyboard-input {
        pressed: list<s32>,
        pressed-once: list<s32>,
    }

    /// `cuo:chat/message`
    record chat-message {
        serial: u32,
        text: string,
        name: string,
        hue: u16,
        font: u8,
        is-unicode: bool,
        message-type: u8,
        time: f32,
        kind: u8,
    }

    /// `cuo:chat/prompt`
    record prompt-opened-event {
        serial: u32,
        prompt-id: u32,
        unicode: bool,
        text: string,
    }

    /// `cuo:engine/time`
    record time {
        total: f32,
        frame: f32,
    }

    /// `cuo:ent/equipment`
    record equipment-slots {
        serials: list<u32>,
    }

    /// `cuo:ent/facing`
    record facing {
        /// enum Direction (0=North, 1=Right, 2=East, 3=Down, 4=South, 5=Left, 6=West, 7=Up, 7=Mask, 128=Running, 237=NONE)
        value: u8,
    }

    /// `OplLineDto`
    record opl-line {
        cliloc: s32,
        args: string,
        text: string,
    }

    /// `cuo:ent/properties`
    record entity-properties {
        serial: u32,
        revision: u32,
        name: string,
        lines: list<opl-line>,
    }

    /// `cuo:ent/server-flags`
    record server-flags {
        /// enum Flags (0=None, 1=Frozen, 2=Female, 4=Poisoned, 4=Flying, 8=YellowBar, 16=IgnoreMobiles, 32=Movable, 64=WarMode, 128=Hidden)
        value: u8,
    }

    /// `cuo:ent/slot-position`
    record container-slot-position {
        x: u16,
        y: u16,
        grid-index: u8,
    }

    /// `cuo:game/context`
    record game-context {
        player-serial: u32,
        player-name: string,
        %map: s32,
        season: u8,
        client-version: u32,
        use-old-status-gump: bool,
    }

    /// `cuo:game/settings`
    record game-settings {
        grid-loot-type: s32,
        skip-empty-corpse: bool,
        auto-open-corpses: bool,
        auto-open-corpse-range: s32,
        corpse-open-options: s32,
        double-click-to-loot-inside-containers: bool,
        hold-shift-to-split-stack: bool,
        relative-drag-and-drop-items: bool,
        speech-hue: u16,
        always-run: bool,
        highlight-game-objects: bool,
    }

    /// `cuo:game/state`
    record game-state {
        current: u8,
    }

    /// `cuo:gump/container`
    record container-window {
        serial: u32,
    }

    /// `cuo:gump/container-closed`
    record container-closed-event {
        serial: u32,
        user-initiated: bool,
    }

    /// `cuo:gump/container-opened`
    record container-opened-event {
        serial: u32,
        graphic: u16,
    }

    /// `ContainerPositionDto`
    record container-position {
        serial: u32,
        x: s32,
        y: s32,
    }

    /// `cuo:gump/container-positions`
    record container-positions {
        saved: list<container-position>,
    }

    /// `ContainerSlotAction`
    enum container-slot-action { add, remove }

    /// `cuo:gump/container-slot`
    record container-slot-event {
        action: container-slot-action,
        container-serial: u32,
        item-serial: u32,
        graphic: u16,
        hue: u16,
        x: u16,
        y: u16,
        amount: u16,
    }

    /// `cuo:gump/container-tag`
    record container-gump-tag {
        graphic: u16,
        original-graphic: u16,
        scale: f32,
        bounds-x: s32,
        bounds-y: s32,
        bounds-w: s32,
        bounds-h: s32,
    }

    /// `ContextMenuEntry`
    record context-menu-entry {
        index: u16,
        cliloc: s32,
        text: string,
        %flags: u16,
        hue: u16,
    }

    /// `cuo:gump/context-menu`
    record context-menu-event {
        serial: u32,
        entries: list<context-menu-entry>,
    }

    /// `cuo:gump/grid-container`
    record grid-container-window {
        serial: u32,
    }

    /// `cuo:gump/grid-loot`
    record grid-loot-window {
        corpse-serial: u32,
        corpse-entity: u64,
        content-sig: s32,
    }

    /// `cuo:gump/health-bar`
    record health-bar-window {
        serial: u32,
        is-player: bool,
        out-of-range: bool,
        hp-requested: bool,
        was-dead: bool,
        in-party: bool,
        name-editable: bool,
    }

    /// `ServerGumpButtonDto`
    record server-gump-button {
        id: s32,
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }

    /// `ServerGumpTextEntryDto`
    record server-gump-text-entry {
        id: u16,
        text: string,
    }

    /// `ServerGumpSwitchDto`
    record server-gump-switch {
        id: u32,
        checked: bool,
        is-radio: bool,
        group: s32,
    }

    /// `cuo:gump/server`
    record server-gump {
        serial: u32,
        gump-id: u32,
        page: s32,
        x: s32,
        y: s32,
        layout: list<string>,
        texts: list<string>,
        buttons: list<server-gump-button>,
        text-entries: list<server-gump-text-entry>,
        switches: list<server-gump-switch>,
    }

    /// `cuo:input/consume`
    record input-consume {
        mouse: u8,
        key: u32,
    }

    /// `HostHotkeyDto`
    record host-hotkey {
        key: s32,
        ctrl: bool,
        shift: bool,
        alt: bool,
        action: string,
    }

    /// `cuo:input/host-hotkeys`
    record host-hotkeys {
        hotkeys: list<host-hotkey>,
    }

    /// `cuo:input/hotkey`
    record mod-hotkey-fired {
        name: string,
        key: s32,
        mouse: s32,
        ctrl: bool,
        shift: bool,
        alt: bool,
        from-mod: bool,
    }

    /// `ModHotkeyBinding`
    record mod-hotkey-binding {
        name: string,
        key: s32,
        mouse: s32,
        ctrl: bool,
        shift: bool,
        alt: bool,
        consume: bool,
    }

    /// `cuo:input/mod-hotkeys`
    record mod-hotkey-bindings {
        bindings: list<mod-hotkey-binding>,
        consume-keys: bool,
    }

    /// `cuo:input/world-single-click`
    record world-single-click {
        serial: u32,
        at-ms: u64,
    }

    /// `cuo:item/drop-sent`
    record item-drop-sent {
        serial: u32,
        x: u16,
        y: u16,
        z: s8,
        container: u32,
    }

    /// `cuo:item/move-result`
    record item-move-result {
        %result: u8,
        code: u8,
    }

    /// `ModOptionDto`
    record mod-option {
        key: string,
        label: string,
        group: string,
        keywords: string,
        kind: u8,
        min: s32,
        max: s32,
        step: s32,
        default: s32,
        choices: list<string>,
    }

    /// `cuo:options/schema`
    record mod-options-schema {
        options: list<mod-option>,
    }

    /// `PlayerBuffDto`
    record player-buff {
        %type: s32,
        graphic: u16,
        expires-at: f32,
        text: string,
    }

    /// `cuo:player/buffs`
    record player-buffs {
        buffs: list<player-buff>,
    }

    /// `Layer`
    enum layer { invalid, one-handed, two-handed, shoes, pants, shirt, helmet, gloves, ring, talisman, necklace, hair, waist, torso, bracelet, face, beard, tunic, earrings, arms, cloak, backpack, robe, skirt, legs, mount, shop-buy-restock, shop-buy, shop-sell, bank }

    /// `Vector2`
    record vector2 {
        x: f32,
        y: f32,
    }

    /// `cuo:player/grabbed-item`
    record grabbed-item {
        is-active: bool,
        serial: u32,
        graphic: u16,
        hue: u16,
        amount: s32,
        source-ui-entity: u64,
        original-graphic: u16,
        original-hue: u16,
        original-amount: u16,
        original-x: u16,
        original-y: u16,
        original-z: s8,
        original-container: u32,
        original-grid-index: u8,
        original-from-slot: bool,
        original-layer: layer,
        pending-drop: bool,
        drop-target-serial: u32,
        failed-drop: bool,
        mouse-offset: vector2,
    }

    /// `PlayerSkillDto`
    record player-skill {
        index: s32,
        value: u16,
        base: u16,
        cap: u16,
        lock: u8,
    }

    /// `cuo:player/skills`
    record player-skills {
        has-data: bool,
        skills: list<player-skill>,
    }

    /// `cuo:player/stat-locks`
    record stat-locks {
        str: u8,
        dex: u8,
        int: u8,
    }

    /// `cuo:target/local-result`
    record local-target-result-event {
        entity: u64,
        serial: u32,
        graphic: u16,
        x: u16,
        y: u16,
        z: s8,
        cancelled: bool,
    }

    /// `cuo:target/state`
    record targeting-state {
        is-targeting: bool,
        mode: u8,
        local: bool,
        cursor-id: u32,
        cursor-type: u8,
        just-targeted: bool,
        multi-id: u16,
        multi-offset-x: s16,
        multi-offset-y: s16,
        multi-offset-z: s16,
        multi-hue: u16,
        preview-built-id: u16,
        has-local-result: bool,
        local-serial: u32,
        local-graphic: u16,
        local-x: u16,
        local-y: u16,
        local-z: s8,
        local-cancelled: bool,
    }

    /// `cuo:ui/border-color`
    record border-color {
        r: f32,
        g: f32,
        b: f32,
        a: f32,
    }

    /// `cuo:ui/button`
    record uo-button {
        normal: u16,
        pressed: u16,
        over: u16,
    }

    /// `cuo:ui/computed`
    record computed-node {
        size: vector2,
        position: vector2,
        clay-id: u32,
        paint-order: s32,
    }

    /// `Vector3`
    record vector3 {
        x: f32,
        y: f32,
        z: f32,
    }

    /// `cuo:ui/container-item`
    record container-item-ui {
        container: entity,
        serial: u32,
        original-hue: vector3,
        hover-hue: vector3,
    }

    /// `cuo:ui/custom`
    record ui-custom {
        kind: u8,
        asset-id: u32,
        hue-x: f32,
        hue-y: f32,
        hue-z: f32,
        stacked: bool,
    }

    /// `cuo:ui/editable-text`
    record editable-text {
        multiline: bool,
    }

    /// `cuo:ui/hover`
    record ui-hover {
        over: bool,
    }

    /// `cuo:ui/hover-tint`
    record ui-hover-tint {
        normal: color,
        hover: color,
    }

    /// `cuo:ui/name`
    record ui-name {
        value: string,
    }

    /// `cuo:ui/pick`
    record ui-pick {
        entity: u64,
        root: u64,
        paint-order: s32,
        x: f32,
        y: f32,
    }

    /// `cuo:ui/resizable`
    record ui-resizable {
        min-w: f32,
        min-h: f32,
        max-w: f32,
        max-h: f32,
        grip: f32,
        grip-inset: f32,
        whole-pixels: bool,
    }

    /// `cuo:ui/right-click`
    record ui-right-click {
        x: f32,
        y: f32,
    }

    /// `cuo:ui/scroll`
    record scroll-position {
        offset-x: f32,
        offset-y: f32,
    }

    /// `ScrollbarStyle`
    enum scrollbar-style { uo, flat }

    /// `cuo:ui/scrollbar`
    record ui-scrollbar {
        width: f32,
        style: scrollbar-style,
    }

    /// `cuo:ui/stat-lock-button`
    record stat-lock-button {
        stat: u8,
    }

    /// `cuo:ui/statusbar-window`
    record status-bar-window {
        minimize-x: f32,
        minimize-y: f32,
    }

    /// `cuo:ui/supersedes`
    record mod-supersedes {
        feature: string,
    }

    /// `cuo:ui/surface`
    record ui-surface {
        w: f32,
        h: f32,
    }

    /// `cuo:ui/text-caret`
    record text-caret {
        entity: u64,
        cursor: s32,
        select-start: s32,
        select-end: s32,
        line: s32,
        column: s32,
        screen-x: f32,
        screen-y: f32,
        row-height: f32,
    }

    /// `cuo:ui/text-completion-state`
    record text-completion-state {
        selected: s32,
    }

    /// `cuo:ui/text-hue`
    record text-hue {
        value: u16,
    }

    /// `TextSpan`
    record text-span {
        start: s32,
        length: s32,
        color: color,
    }

    /// `cuo:ui/text-spans`
    record text-spans {
        spans: list<text-span>,
    }

    /// `TextWrapKind`
    enum text-wrap-kind { words, newlines, none }

    /// `cuo:ui/text-wrap`
    record text-wrap {
        kind: text-wrap-kind,
    }

    /// `cuo:ui/tooltip`
    record ui-tooltip {
        text: string,
        max-width: s32,
    }
}

/// Typed reads and writes of the `types` records — no JSON. Everything here is deferred
/// like `commands`: applied after the system returns, in order with its other commands.
///
/// An observer of a typed component / event may take its trigger typed: its export
/// declares `entity: entity, value: <record>` (a tag: `entity: entity` alone) as its
/// leading parameters instead of `trigger: trigger-data`. The host reads the export's
/// signature when it binds it.
interface components {
    use tinyecs:modding/ecs@0.1.0.{commands, query, res, events, entity};
    use types.{hits, mana, stamina, player-data, serial, graphic, hue, world-position, notoriety, entity-name, amount, node, text, text-font, text-color, background-color, border-radius, child-of, global-z-index, interaction, mouse-input, keyboard-input, chat-message, prompt-opened-event, time, equipment-slots, facing, entity-properties, server-flags, container-slot-position, game-context, game-settings, game-state, container-window, container-closed-event, container-opened-event, container-positions, container-slot-event, container-gump-tag, context-menu-event, grid-container-window, grid-loot-window, health-bar-window, server-gump, input-consume, host-hotkeys, mod-hotkey-fired, mod-hotkey-bindings, world-single-click, item-drop-sent, item-move-result, mod-options-schema, player-buffs, grabbed-item, player-skills, stat-locks, local-target-result-event, targeting-state, border-color, uo-button, computed-node, container-item-ui, ui-custom, editable-text, ui-hover, ui-hover-tint, ui-name, ui-pick, ui-resizable, ui-right-click, scroll-position, ui-scrollbar, stat-lock-button, status-bar-window, mod-supersedes, ui-surface, text-caret, text-completion-state, text-hue, text-spans, text-wrap, ui-tooltip};

    /// Inserts components on one entity, chained: each method queues one insert and
    /// returns a new builder for the same entity.
    resource entity-builder {
        /// The entity (a spawned one's id is valid at once).
        id: func() -> entity;
        /// Inserts `cuo:ent/graphic`.
        graphic: func(v: graphic) -> entity-builder;
        /// Inserts `cuo:ent/hue`.
        hue: func(v: hue) -> entity-builder;
        /// Inserts `cuo:ent/world-position`.
        world-position: func(v: world-position) -> entity-builder;
        /// Inserts `cuo:ent/notoriety`.
        notoriety: func(v: notoriety) -> entity-builder;
        /// Inserts `cuo:ent/name`.
        name: func(v: entity-name) -> entity-builder;
        /// Inserts `cuo:ent/amount`.
        amount: func(v: amount) -> entity-builder;
        /// Inserts `cuo:ui/node`.
        node: func(v: node) -> entity-builder;
        /// Inserts `cuo:ui/text`.
        text: func(v: text) -> entity-builder;
        /// Inserts `cuo:ui/text-font`.
        text-font: func(v: text-font) -> entity-builder;
        /// Inserts `cuo:ui/text-color`.
        text-color: func(v: text-color) -> entity-builder;
        /// Inserts `cuo:ui/bg-color`.
        bg-color: func(v: background-color) -> entity-builder;
        /// Inserts `cuo:ui/border-radius`.
        border-radius: func(v: border-radius) -> entity-builder;
        /// Inserts `cuo:ecs/child-of`.
        child-of: func(v: child-of) -> entity-builder;
        /// Inserts `cuo:ui/movable`.
        movable: func() -> entity-builder;
        /// Inserts `cuo:ui/no-window-drag`.
        no-window-drag: func() -> entity-builder;
        /// Inserts `cuo:ui/global-z`.
        global-z: func(v: global-z-index) -> entity-builder;
        /// Inserts `cuo:ui/interaction`.
        interaction: func(v: interaction) -> entity-builder;
        /// Inserts `cuo:ent/facing`.
        facing: func(v: facing) -> entity-builder;
        /// Inserts `cuo:ent/slot-position`.
        slot-position: func(v: container-slot-position) -> entity-builder;
        /// Inserts `cuo:gump/container`.
        container: func(v: container-window) -> entity-builder;
        /// Inserts `cuo:gump/container-tag`.
        container-tag: func(v: container-gump-tag) -> entity-builder;
        /// Inserts `cuo:gump/grid-container`.
        grid-container: func(v: grid-container-window) -> entity-builder;
        /// Inserts `cuo:gump/grid-loot`.
        grid-loot: func(v: grid-loot-window) -> entity-builder;
        /// Inserts `cuo:gump/health-bar`.
        health-bar: func(v: health-bar-window) -> entity-builder;
        /// Inserts `cuo:player/player`.
        player: func() -> entity-builder;
        /// Inserts `cuo:ui/border-color`.
        border-color: func(v: border-color) -> entity-builder;
        /// Inserts `cuo:ui/button`.
        button: func(v: uo-button) -> entity-builder;
        /// Inserts `cuo:ui/container-item`.
        container-item: func(v: container-item-ui) -> entity-builder;
        /// Inserts `cuo:ui/contains-by-bounds`.
        contains-by-bounds: func() -> entity-builder;
        /// Inserts `cuo:ui/custom`.
        custom: func(v: ui-custom) -> entity-builder;
        /// Inserts `cuo:ui/editable-text`.
        editable-text: func(v: editable-text) -> entity-builder;
        /// Inserts `cuo:ui/hover-tint`.
        hover-tint: func(v: ui-hover-tint) -> entity-builder;
        /// Inserts `cuo:ui/movable-no-drag`.
        movable-no-drag: func() -> entity-builder;
        /// Inserts `cuo:ui/name`.
        ui-name: func(v: ui-name) -> entity-builder;
        /// Inserts `cuo:ui/no-blur`.
        no-blur: func() -> entity-builder;
        /// Inserts `cuo:ui/no-pickup`.
        no-pickup: func() -> entity-builder;
        /// Inserts `cuo:ui/no-right-click-close`.
        no-right-click-close: func() -> entity-builder;
        /// Inserts `cuo:ui/options-window`.
        options-window: func() -> entity-builder;
        /// Inserts `cuo:ui/popup`.
        popup: func() -> entity-builder;
        /// Inserts `cuo:ui/resizable`.
        resizable: func(v: ui-resizable) -> entity-builder;
        /// Inserts `cuo:ui/scroll`.
        scroll: func(v: scroll-position) -> entity-builder;
        /// Inserts `cuo:ui/scrollbar`.
        scrollbar: func(v: ui-scrollbar) -> entity-builder;
        /// Inserts `cuo:ui/stat-lock-button`.
        stat-lock-button: func(v: stat-lock-button) -> entity-builder;
        /// Inserts `cuo:ui/statusbar-window`.
        statusbar-window: func(v: status-bar-window) -> entity-builder;
        /// Inserts `cuo:ui/supersedes`.
        supersedes: func(v: mod-supersedes) -> entity-builder;
        /// Inserts `cuo:ui/text-hue`.
        text-hue: func(v: text-hue) -> entity-builder;
        /// Inserts `cuo:ui/text-input`.
        text-input: func() -> entity-builder;
        /// Inserts `cuo:ui/text-spans`.
        text-spans: func(v: text-spans) -> entity-builder;
        /// Inserts `cuo:ui/text-wrap`.
        text-wrap: func(v: text-wrap) -> entity-builder;
        /// Inserts `cuo:ui/tooltip`.
        tooltip: func(v: ui-tooltip) -> entity-builder;
        /// Inserts `cuo:ui/topbar-bg`.
        topbar-bg: func() -> entity-builder;
        /// Inserts `cuo:ui/topbar-button`.
        topbar-button: func() -> entity-builder;
        /// Inserts `cuo:ui/topbar-full`.
        topbar-full: func() -> entity-builder;
        /// Inserts `cuo:ui/topbar-root`.
        topbar-root: func() -> entity-builder;
    }

    /// A builder for an existing entity.
    entity-of: func(c: borrow<commands>, e: entity) -> entity-builder;
    /// Spawns an entity (its id is valid at once) and returns its builder.
    spawn: func(c: borrow<commands>) -> entity-builder;

    /// `cuo:player/hits` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:player/hits`.
    column-hits: func(q: borrow<query>, term: u8) -> list<hits>;

    /// `cuo:player/mana` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:player/mana`.
    column-mana: func(q: borrow<query>, term: u8) -> list<mana>;

    /// `cuo:player/stamina` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:player/stamina`.
    column-stamina: func(q: borrow<query>, term: u8) -> list<stamina>;

    /// `cuo:player/data` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:player/data`.
    column-data: func(q: borrow<query>, term: u8) -> list<player-data>;

    /// `cuo:ent/serial` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/serial`.
    column-serial: func(q: borrow<query>, term: u8) -> list<serial>;

    /// `cuo:ent/graphic` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/graphic`.
    column-graphic: func(q: borrow<query>, term: u8) -> list<graphic>;
    /// Writes `cuo:ent/graphic` back through the `mut` reading term `term`.
    set-graphic: func(q: borrow<query>, e: entity, term: u8, v: graphic);

    /// `cuo:ent/hue` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/hue`.
    column-hue: func(q: borrow<query>, term: u8) -> list<hue>;
    /// Writes `cuo:ent/hue` back through the `mut` reading term `term`.
    set-hue: func(q: borrow<query>, e: entity, term: u8, v: hue);

    /// `cuo:ent/world-position` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/world-position`.
    column-world-position: func(q: borrow<query>, term: u8) -> list<world-position>;
    /// Writes `cuo:ent/world-position` back through the `mut` reading term `term`.
    set-world-position: func(q: borrow<query>, e: entity, term: u8, v: world-position);

    /// `cuo:ent/notoriety` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/notoriety`.
    column-notoriety: func(q: borrow<query>, term: u8) -> list<notoriety>;
    /// Writes `cuo:ent/notoriety` back through the `mut` reading term `term`.
    set-notoriety: func(q: borrow<query>, e: entity, term: u8, v: notoriety);

    /// `cuo:ent/name` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/name`.
    column-name: func(q: borrow<query>, term: u8) -> list<entity-name>;
    /// Writes `cuo:ent/name` back through the `mut` reading term `term`.
    set-name: func(q: borrow<query>, e: entity, term: u8, v: entity-name);

    /// `cuo:ent/amount` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/amount`.
    column-amount: func(q: borrow<query>, term: u8) -> list<amount>;
    /// Writes `cuo:ent/amount` back through the `mut` reading term `term`.
    set-amount: func(q: borrow<query>, e: entity, term: u8, v: amount);

    /// `cuo:ui/node` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/node`.
    column-node: func(q: borrow<query>, term: u8) -> list<node>;
    /// Writes `cuo:ui/node` back through the `mut` reading term `term`.
    set-node: func(q: borrow<query>, e: entity, term: u8, v: node);

    /// `cuo:ui/text` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/text`.
    column-text: func(q: borrow<query>, term: u8) -> list<text>;
    /// Writes `cuo:ui/text` back through the `mut` reading term `term`.
    set-text: func(q: borrow<query>, e: entity, term: u8, v: text);

    /// `cuo:ui/text-font` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/text-font`.
    column-text-font: func(q: borrow<query>, term: u8) -> list<text-font>;
    /// Writes `cuo:ui/text-font` back through the `mut` reading term `term`.
    set-text-font: func(q: borrow<query>, e: entity, term: u8, v: text-font);

    /// `cuo:ui/text-color` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/text-color`.
    column-text-color: func(q: borrow<query>, term: u8) -> list<text-color>;
    /// Writes `cuo:ui/text-color` back through the `mut` reading term `term`.
    set-text-color: func(q: borrow<query>, e: entity, term: u8, v: text-color);

    /// `cuo:ui/bg-color` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/bg-color`.
    column-bg-color: func(q: borrow<query>, term: u8) -> list<background-color>;
    /// Writes `cuo:ui/bg-color` back through the `mut` reading term `term`.
    set-bg-color: func(q: borrow<query>, e: entity, term: u8, v: background-color);

    /// `cuo:ui/border-radius` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/border-radius`.
    column-border-radius: func(q: borrow<query>, term: u8) -> list<border-radius>;
    /// Writes `cuo:ui/border-radius` back through the `mut` reading term `term`.
    set-border-radius: func(q: borrow<query>, e: entity, term: u8, v: border-radius);

    /// `cuo:ecs/child-of` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ecs/child-of`.
    column-child-of: func(q: borrow<query>, term: u8) -> list<child-of>;
    /// Writes `cuo:ecs/child-of` back through the `mut` reading term `term`.
    set-child-of: func(q: borrow<query>, e: entity, term: u8, v: child-of);

    /// `cuo:ui/global-z` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/global-z`.
    column-global-z: func(q: borrow<query>, term: u8) -> list<global-z-index>;
    /// Writes `cuo:ui/global-z` back through the `mut` reading term `term`.
    set-global-z: func(q: borrow<query>, e: entity, term: u8, v: global-z-index);

    /// `cuo:ui/interaction` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ui/interaction`.
    column-interaction: func(q: borrow<query>, term: u8) -> list<interaction>;
    /// Writes `cuo:ui/interaction` back through the `mut` reading term `term`.
    set-interaction: func(q: borrow<query>, e: entity, term: u8, v: interaction);

    /// `cuo:ent/equipment` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/equipment`.
    column-equipment: func(q: borrow<query>, term: u8) -> list<equipment-slots>;

    /// `cuo:ent/facing` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/facing`.
    column-facing: func(q: borrow<query>, term: u8) -> list<facing>;
    /// Writes `cuo:ent/facing` back through the `mut` reading term `term`.
    set-facing: func(q: borrow<query>, e: entity, term: u8, v: facing);

    /// `cuo:ent/properties` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/properties`.
    column-properties: func(q: borrow<query>, term: u8) -> list<entity-properties>;

    /// `cuo:ent/server-flags` of every matched entity, aligned with `query.entities`. Traps unless
    /// reading term `term` is `cuo:ent/server-flags`.
    column-server-flags: func(q: borrow<query>, term: u8) -> list<server-flags>;

    /// `cuo:ent/slot-position` of every matched entity, aligned with `query.entities`. Traps unless
