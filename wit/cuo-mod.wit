        towns: list<town-info>,
    }

    /// `LoginErrorInfo`
    record login-error-info {
        error-message: string,
    }

    /// `cuo:scene/login-error-info`
    record login-errors-info-event {
        error: login-error-info,
    }

    /// `ServerInfo`
    record server-info {
        index: s32,
        name: string,
        percent-full: u8,
        time-zone: u8,
        ip: u32,
    }

    /// `cuo:scene/server-list`
    record server-selection-info-event {
