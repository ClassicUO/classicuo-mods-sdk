    enum anchor-kind { spell, healthbar }

    /// `cuo:ui/anchorable`
    record anchorable {
        kind: anchor-kind,
    }

    /// `cuo:ui/border-color`
    record border-color {
        r: f32,
        g: f32,
        b: f32,
        a: f32,
    }

    /// `cuo:ui/button`
