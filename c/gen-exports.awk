# Turns the export prototypes wit-bindgen c wrote into cuo_wit.h into trampolines
# (cuo_exports.c): one per system export of the mod's world, handing its arguments to
# the SDK dispatcher, plus the table of export names + parameter kinds the SDK checks
# the systems declared in cuo_setup against. `setup` and the SDK's own
# `cuo-sdk-hotkeys` are implemented in the SDK.
#
#   awk -f gen-exports.awk build/gen/cuo_wit.h > build/gen/cuo_exports.c

BEGIN { count = 0 }

{ sub(/[[:cntrl:]]$/, "") }

/^void exports_cuo_wit_[a-z0-9_]+\(.*\);$/ {
    line = $0
    sub(/^void exports_cuo_wit_/, "", line)
    name = substr(line, 1, index(line, "(") - 1)
    if (name == "setup" || name == "cuo_sdk_hotkeys")
        next
    args = substr(line, index(line, "(") + 1)
    sub(/\);$/, "", args)
    n = 0
    if (args != "void") {
        k = split(args, parts, /, /)
        for (i = 1; i <= k; i++) {
            match(parts[i], /[A-Za-z_][A-Za-z0-9_]*$/)
            types[count, n] = substr(parts[i], 1, RSTART - 1)
            n++
        }
    }
    names[count] = name
    nargs[count] = n
    count++
}

END {
    print "/* GENERATED by gen-exports.awk from cuo_wit.h (the mod's wit/world.wit). Do not edit. */"
    print "#include \"cuo/exports.h\""
    print ""
    for (e = 0; e < count; e++) {
        printf "static const uint8_t cuo__kinds_%s[] = { ", names[e]
        for (i = 0; i < nargs[e]; i++)
            printf "%sCUO__KIND(%s)", (i ? ", " : ""), types[e, i]
        printf "%s };\n", (nargs[e] ? "" : "0")
    }
    print ""
    printf "const cuo__export cuo__exports[] = {\n"
    for (e = 0; e < count; e++) {
        kebab = names[e]
        gsub(/_/, "-", kebab)
        printf "    { \"%s\", cuo__kinds_%s, %d },\n", kebab, names[e], nargs[e]
    }
    if (!count)
        print "    { 0 },"
    print "};"
    printf "const size_t cuo__nexports = %d;\n", count
    for (e = 0; e < count; e++) {
        print ""
        printf "void exports_cuo_wit_%s(", names[e]
        if (!nargs[e])
            printf "void"
        for (i = 0; i < nargs[e]; i++)
            printf "%s%sp%d", (i ? ", " : ""), types[e, i], i
        print ")"
        print "{"
        if (nargs[e]) {
            printf "    cuo__arg a[] = { "
            for (i = 0; i < nargs[e]; i++)
                printf "%sCUO__ARG(p%d)", (i ? ", " : ""), i
            print " };"
            printf "    cuo__dispatch(&cuo__exports[%d], a);\n", e
        } else {
            printf "    cuo__dispatch(&cuo__exports[%d], NULL);\n", e
        }
        print "}"
    }
}
